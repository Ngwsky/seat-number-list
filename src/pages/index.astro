---
import "../styles/global.css"
// Component Imports
import SeatNoList2Svg from "../components/SeatNoList2Svg.svelte"
import Theme from "../components/Theme.svelte"
import Footer from "../components/Footer.svelte"

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>SNL2SVG</title>
  </head>

  <body>
    <div class="min-h-screen pb-12">
      <div class="navbar shadow-sm min-h-2">
        <div class="flex-1">
          <a class="btn btn-ghost text-md h-auto"
            >Seat Number List to SVG</a
          >
        </div>
        <div class="flex-none">
          <Theme client:only="svelte" />
        </div>
      </div>
      <div class="@container">
        <div
          class="flex flex-row flex-wrap m-auto w-full bg-base-200 font-mono"
        >
          <SeatNoList2Svg client:only="svelte" />
        </div>
      </div>
      <footer
        class="fixed bottom-0 left-0 w-full footer footer-horizontal bg-base-100 items-center px-4 py-2 z-50"
      >
        <Footer client:only="svelte" />
      </footer>
    </div>
  </body>
</html>
